# Copy to .env and fill in what you use (.env is gitignored):
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env

# LM Studio's address is NOT set here -- it lives in docker/config.toml, in
# both [providers.qwen] base_url and [chat] passthrough_url. Open WebUI no
# longer talks to LM Studio directly; it goes through Big Brother.

# LM Studio ignores API keys, but the proxy requires a non-empty value.
LMSTUDIO=lm-studio

# Cloud provider keys. Leave blank to leave that provider unusable.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
Z_AI_API_KEY=

# Grafana admin login (user "admin"). This default is documented, not secret;
# override it in .env if the dashboard matters to you.
GRAFANA_ADMIN_PASSWORD=admin
